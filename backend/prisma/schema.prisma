// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  job_seeker
  employer
  admin
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

enum DataSource {
  CV
  MANUAL
}

enum CvProcessingStatus {
  UPLOADING
  PARSING
  PARSED
  MERGE_PENDING
  MERGED
  FAILED
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(job_seeker)
  cvUrl        String?     @map("cv_url")
  avatarUrl    String?     @map("avatar_url")
  createdAt    DateTime    @default(now()) @map("created_at")

  profile        UserProfile?
  education      UserEducation[]
  experience     UserExperience[]
  projects       UserProject[]
  certifications UserCertification[]
  languages      UserLanguage[]
  preferences    UserPreference?
  cvVersions     UserCV[]

  companies    Company[]   @relation("CompanyOwner")
  applications Application[]
  userSkills   UserSkill[]
  savedJobs    SavedJob[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  location      String?
  employeeCount String?  @map("employee_count")
  sector        String?
  logoUrl       String?  @map("logo_url")
  ownerId       String   @map("owner_id")
  owner         User     @relation("CompanyOwner", fields: [ownerId], references: [id])

  jobs        Job[]

  @@map("companies")
}

model Job {
  id               String   @id @default(uuid())
  title            String
  description      String
  companyId        String   @map("company_id")
  company          Company  @relation(fields: [companyId], references: [id])
  location         String
  city             String?
  district         String?
  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  currency         String   @default("TRY")
  workModel        String   @default("onsite") @map("work_model") // onsite, remote, hybrid
  educationLevel   String?  @map("education_level")
  experienceYears  String?  @map("experience_years")
  militaryStatus   String?  @map("military_status")
  language         String?
  remote           Boolean  @default(false)
  viewCount        Int      @default(0) @map("view_count")
  createdAt        DateTime @default(now()) @map("created_at")

  applications Application[]
  jobSkills    JobSkill[]
  savedBy      SavedJob[]

  @@index([city])
  @@index([title])
  @@index([companyId])
  @@index([createdAt])
  @@map("jobs")
}

model Application {
  id        String            @id @default(uuid())
  jobId     String            @map("job_id")
  userId    String            @map("user_id")
  job       Job               @relation(fields: [jobId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  cvUrl     String?           @map("cv_url")
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("applications")
}

model SavedJob {
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("saved_jobs")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  userSkills UserSkill[]
  jobSkills  JobSkill[]

  @@map("skills")
}

model UserSkill {
  userId        String      @map("user_id")
  skillId       String      @map("skill_id")
  level         Int         @default(1)
  sourceType    DataSource  @default(MANUAL) @map("source_type")
  sourceId      String?     @map("source_id")
  lastUpdatedBy DataSource  @default(MANUAL) @map("last_updated_by")
  lastUpdatedAt DateTime    @default(now()) @map("last_updated_at")
  confidence    Float?
  deletedAt     DateTime?   @map("deleted_at")

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model JobSkill {
  jobId    String  @map("job_id")
  skillId  String  @map("skill_id")
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model UserProfile {
  id             String      @id @default(uuid())
  userId         String      @unique @map("user_id")
  about          String?     @db.Text
  aboutSource    DataSource  @default(MANUAL) @map("about_source")
  title          String?
  phone          String?
  birthDate      DateTime?   @map("birth_date")
  gender         String?
  militaryStatus String?     @map("military_status")
  driverLicense  String?     @map("driver_license")
  city           String?
  district       String?
  githubUrl      String?     @map("github_url")
  linkedinUrl    String?     @map("linkedin_url")
  portfolioUrl   String?     @map("portfolio_url")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserEducation {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  school         String
  degree         String      // Lise, Önlisans, Lisans, Yüksek Lisans vb.
  fieldOfStudy   String      @map("field_of_study")
  startDate      DateTime    @map("start_date")
  endDate        DateTime?   @map("end_date")
  isContinuing   Boolean     @default(false) @map("is_continuing")
  grade          String?
  sourceType     DataSource  @default(MANUAL) @map("source_type")
  sourceId       String?     @map("source_id")
  lastUpdatedBy  DataSource  @default(MANUAL) @map("last_updated_by")
  lastUpdatedAt  DateTime    @default(now()) @map("last_updated_at")
  confidence     Float?
  deletedAt      DateTime?   @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_education")
}

model UserExperience {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  company        String
  title          String
  location       String?
  startDate      DateTime    @map("start_date")
  endDate        DateTime?   @map("end_date")
  isContinuing   Boolean     @default(false) @map("is_continuing")
  description    String?     @db.Text
  sourceType     DataSource  @default(MANUAL) @map("source_type")
  sourceId       String?     @map("source_id")
  lastUpdatedBy  DataSource  @default(MANUAL) @map("last_updated_by")
  lastUpdatedAt  DateTime    @default(now()) @map("last_updated_at")
  confidence     Float?
  deletedAt      DateTime?   @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_experience")
}

model UserProject {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  description    String?     @db.Text
  url            String?
  technologies   String[]
  startDate      DateTime?   @map("start_date")
  endDate        DateTime?   @map("end_date")
  isContinuing   Boolean     @default(false) @map("is_continuing")
  sourceType     DataSource  @default(MANUAL) @map("source_type")
  sourceId       String?     @map("source_id")
  lastUpdatedBy  DataSource  @default(MANUAL) @map("last_updated_by")
  lastUpdatedAt  DateTime    @default(now()) @map("last_updated_at")
  confidence     Float?
  deletedAt      DateTime?   @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_projects")
}

model UserCertification {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  issuer         String?
  issueDate      DateTime?   @map("issue_date")
  expirationDate DateTime?   @map("expiration_date")
  credentialUrl  String?     @map("credential_url")
  sourceType     DataSource  @default(MANUAL) @map("source_type")
  sourceId       String?     @map("source_id")
  lastUpdatedBy  DataSource  @default(MANUAL) @map("last_updated_by")
  lastUpdatedAt  DateTime    @default(now()) @map("last_updated_at")
  confidence     Float?
  deletedAt      DateTime?   @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_certifications")
}

model UserLanguage {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  language      String
  level         String      // A1, A2, B1, B2, C1, C2, Native
  sourceType    DataSource  @default(MANUAL) @map("source_type")
  sourceId      String?     @map("source_id")
  lastUpdatedBy DataSource  @default(MANUAL) @map("last_updated_by")
  lastUpdatedAt DateTime    @default(now()) @map("last_updated_at")
  confidence    Float?
  deletedAt     DateTime?   @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_languages")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  currency         String   @default("TRY")
  workModels       String[] @map("work_models") // ["onsite", "remote", "hybrid"]
  preferredCities  String[] @map("preferred_cities")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// CV Versioning - tracks all uploaded CVs
model UserCV {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  version          Int                @default(1)
  fileName         String             @map("file_name")
  filePath         String             @map("file_path")
  fileSize         Int?               @map("file_size")
  uploadDate       DateTime           @default(now()) @map("upload_date")
  processingStatus CvProcessingStatus @default(UPLOADING) @map("processing_status")
  parsedData       Json?              @map("parsed_data")
  mergePreview     Json?              @map("merge_preview")
  parsedAt         DateTime?          @map("parsed_at")
  mergedAt         DateTime?          @map("merged_at")
  isActive         Boolean            @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_cvs")
}

// Audit Log - tracks all profile changes
model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   // CREATE, UPDATE, DELETE, CV_UPLOAD, CV_DELETE, CV_MERGE
  entityType String   @map("entity_type") // EDUCATION, EXPERIENCE, PROJECT, CERTIFICATION, SKILL, LANGUAGE, PROFILE, CV
  entityId   String?  @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  metadata   Json?    // extra context (e.g. CV version, merge details)
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([timestamp])
  @@map("audit_logs")
}
