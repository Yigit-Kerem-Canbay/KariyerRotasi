// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  job_seeker
  employer
  admin
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(job_seeker)
  cvUrl        String?     @map("cv_url")
  createdAt    DateTime    @default(now()) @map("created_at")

  companies    Company[]   @relation("CompanyOwner")
  applications Application[]
  userSkills   UserSkill[]

  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  location      String?
  employeeCount String?  @map("employee_count")
  sector        String?
  logoUrl       String?  @map("logo_url")
  ownerId       String   @map("owner_id")
  owner         User     @relation("CompanyOwner", fields: [ownerId], references: [id])

  jobs        Job[]

  @@map("companies")
}

model Job {
  id               String   @id @default(uuid())
  title            String
  description      String
  companyId        String   @map("company_id")
  company          Company  @relation(fields: [companyId], references: [id])
  location         String
  city             String?
  district         String?
  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  currency         String   @default("TRY")
  workModel        String   @default("onsite") @map("work_model") // onsite, remote, hybrid
  educationLevel   String?  @map("education_level")
  experienceYears  String?  @map("experience_years")
  militaryStatus   String?  @map("military_status")
  language         String?
  remote           Boolean  @default(false)
  viewCount        Int      @default(0) @map("view_count")
  createdAt        DateTime @default(now()) @map("created_at")

  applications Application[]
  jobSkills    JobSkill[]

  @@index([city])
  @@index([title])
  @@index([companyId])
  @@index([createdAt])
  @@map("jobs")
}

model Application {
  id        String            @id @default(uuid())
  jobId     String            @map("job_id")
  userId    String            @map("user_id")
  job       Job               @relation(fields: [jobId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  cvUrl     String?           @map("cv_url")
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([jobId])
  @@index([userId])
  @@map("applications")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  userSkills UserSkill[]
  jobSkills  JobSkill[]

  @@map("skills")
}

model UserSkill {
  userId  String @map("user_id")
  skillId String @map("skill_id")
  level   Int    @default(1)

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model JobSkill {
  jobId    String  @map("job_id")
  skillId  String  @map("skill_id")
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}
