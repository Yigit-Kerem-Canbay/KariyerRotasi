// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  job_seeker
  employer
  admin
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(job_seeker)
  cvUrl        String?     @map("cv_url")
  avatarUrl    String?     @map("avatar_url")
  createdAt    DateTime    @default(now()) @map("created_at")

  profile      UserProfile?
  education    UserEducation[]
  experience   UserExperience[]
  languages    UserLanguage[]
  preferences  UserPreference?

  companies    Company[]   @relation("CompanyOwner")
  applications Application[]
  userSkills   UserSkill[]
  savedJobs    SavedJob[]

  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  location      String?
  employeeCount String?  @map("employee_count")
  sector        String?
  logoUrl       String?  @map("logo_url")
  ownerId       String   @map("owner_id")
  owner         User     @relation("CompanyOwner", fields: [ownerId], references: [id])

  jobs        Job[]

  @@map("companies")
}

model Job {
  id               String   @id @default(uuid())
  title            String
  description      String
  companyId        String   @map("company_id")
  company          Company  @relation(fields: [companyId], references: [id])
  location         String
  city             String?
  district         String?
  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  currency         String   @default("TRY")
  workModel        String   @default("onsite") @map("work_model") // onsite, remote, hybrid
  educationLevel   String?  @map("education_level")
  experienceYears  String?  @map("experience_years")
  militaryStatus   String?  @map("military_status")
  language         String?
  remote           Boolean  @default(false)
  viewCount        Int      @default(0) @map("view_count")
  createdAt        DateTime @default(now()) @map("created_at")

  applications Application[]
  jobSkills    JobSkill[]
  savedBy      SavedJob[]

  @@index([city])
  @@index([title])
  @@index([companyId])
  @@index([createdAt])
  @@map("jobs")
}

model Application {
  id        String            @id @default(uuid())
  jobId     String            @map("job_id")
  userId    String            @map("user_id")
  job       Job               @relation(fields: [jobId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  cvUrl     String?           @map("cv_url")
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("applications")
}

model SavedJob {
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("saved_jobs")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  userSkills UserSkill[]
  jobSkills  JobSkill[]

  @@map("skills")
}

model UserSkill {
  userId  String @map("user_id")
  skillId String @map("skill_id")
  level   Int    @default(1)

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model JobSkill {
  jobId    String  @map("job_id")
  skillId  String  @map("skill_id")
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  about          String?   @db.Text
  title          String?
  phone          String?
  birthDate      DateTime? @map("birth_date")
  gender         String?
  militaryStatus String?   @map("military_status")
  driverLicense  String?   @map("driver_license")
  city           String?
  district       String?
  githubUrl      String?   @map("github_url")
  linkedinUrl    String?   @map("linkedin_url")
  portfolioUrl   String?   @map("portfolio_url")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserEducation {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  school         String
  degree         String    // Lise, Önlisans, Lisans, Yüksek Lisans vb.
  fieldOfStudy   String    @map("field_of_study")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isContinuing   Boolean   @default(false) @map("is_continuing")
  grade          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_education")
}

model UserExperience {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  company        String
  title          String
  location       String?
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isContinuing   Boolean   @default(false) @map("is_continuing")
  description    String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_experience")
}

model UserLanguage {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  language String
  level    String // A1, A2, B1, B2, C1, C2, Native

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_languages")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  currency         String   @default("TRY")
  workModels       String[] @map("work_models") // ["onsite", "remote", "hybrid"]
  preferredCities  String[] @map("preferred_cities")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
